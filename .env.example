# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (server-only: never prefix these with NEXT_PUBLIC_) ---
# Supabase dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- App secret ---
# Used to hash IPs and sign cookies. Generate with: openssl rand -base64 32
APP_SECRET=

# --- Public site settings ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shown on the privacy page for deletion requests
NEXT_PUBLIC_CONTACT_EMAIL=hola@example.com

# --- Email (optional until you own a domain) ---
# Leave RESEND_API_KEY empty to switch confirmation emails off:
# sign-ups then count straight away and deletion is via the contact email.
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. "Vente <hola@vente.es>"
EMAIL_FROM=
