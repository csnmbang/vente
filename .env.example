# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (server-only: never prefix these with NEXT_PUBLIC_) ---
# Supabase dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- App secret ---
# Used to hash IPs and sign cookies. Generate with: openssl rand -base64 32
APP_SECRET=

# --- Public site settings ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shown on the privacy page for deletion requests
NEXT_PUBLIC_CONTACT_EMAIL=hola@vengavente.com

# --- Email (Resend) ---
# Leave RESEND_API_KEY empty (e.g. local dev) to switch emails off:
# sign-ups then count straight away and deletion is via the contact email.
RESEND_API_KEY=
# Must be on the domain verified in Resend (vengavente.com)
EMAIL_FROM="Vente <hola@vengavente.com>"

# Private /admin page (vengavente.com/admin?clave=...). Generate: openssl rand -hex 24
ADMIN_KEY=
